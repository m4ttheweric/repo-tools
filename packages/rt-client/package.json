{
  "name": "@mattstack/rt-client",
  "version": "0.14.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/settings/identity-codec.d.ts",
      "bun": "./src/settings/identity-codec.ts",
      "import": "./dist/settings/identity-codec.js",
      "default": "./dist/settings/identity-codec.js"
    },
    "./test/fake-daemon.ts": "./test/fake-daemon.ts"
  },
  "peerDependencies": {
    "@mattstack/glance": ">=0.23.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "description": "Typed client for the rt daemon: repos, worktrees, ports, tokens, and the event relay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4ttstack/rt.git",
    "directory": "packages/rt-client"
  },
  "homepage": "https://rt.cool",
  "bugs": {
    "url": "https://github.com/m4ttstack/rt/issues"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --packages external && bun build src/settings/identity-codec.ts --outfile dist/settings/identity-codec.js --target browser --format esm && tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "prepack": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
