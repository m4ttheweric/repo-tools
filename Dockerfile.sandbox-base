# Base for the repo-tools cloud-lane sandbox image (research profile).
# Mirrors what a validate image provides: the repo seeded at /app with deps
# installed, git for the seed's fetch/checkout, node for /opt/mc scripts.
# Built locally (docker buildx, linux/amd64) and pushed to the cluster
# registry; nightly-bake wiring for mattstack repos is a deliberate
# follow-up (MAT-223 plan, Task C2).
#
# Rebuild + push (operator, from the repo root — never from rt itself):
#   docker buildx build --platform linux/amd64 -f Dockerfile.sandbox-base \
#     -t <registry>/repo-tools-sandbox-base:<tag> --push .
# Verify the bake before pushing a lane at it:
#   docker run --rm <image> zsh -c 'fzf --version && termwright --version \
#     && git -C /app remote get-url origin && git -C /app config core.sshCommand'

# termwright builder: Debian's cargo (1.85) is too old for the crate, so a
# current toolchain comes from rustup; only the binary reaches the final
# image. Built on bookworm so its glibc floor never exceeds the base's.
FROM debian:bookworm-slim AS termwright-build
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config libssl-dev \
  && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
RUN cargo install termwright --locked

FROM oven/bun:1-debian
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates curl \
  && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
  # python3/make/g++: node-pty's node-gyp build needs a toolchain
  # zsh/file/lsof/procps: lane basics the first cloud lane had to self-provision
  && apt-get install -y --no-install-recommends nodejs python3 make g++ zsh file lsof procps \
  && rm -rf /var/lib/apt/lists/*
# fzf from the pinned release binary: Debian ships 0.60, which rejects rt's
# --expect=ctrl-up (needs >= 0.74).
ARG FZF_VERSION=0.74.2
ARG FZF_SHA256=b3648f48675612b69ee35371cf6dc99ca96d767e89b912d079080916ac8ba8bd
RUN curl -fsSL -o /tmp/fzf.tar.gz \
    "https://github.com/junegunn/fzf/releases/download/v${FZF_VERSION}/fzf-${FZF_VERSION}-linux_amd64.tar.gz" \
  && echo "${FZF_SHA256}  /tmp/fzf.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/fzf.tar.gz -C /usr/local/bin fzf \
  && rm /tmp/fzf.tar.gz
COPY --from=termwright-build /root/.cargo/bin/termwright /usr/local/bin/termwright
ENV HOME=/root
WORKDIR /app
COPY . /app
RUN bun install --frozen-lockfile
# Point /app at the in-cluster receiver so a lane can push without
# self-provisioning. Inert at build time: /keys/client only exists in-pod.
RUN git remote set-url origin ssh://git@receiver.mc-system.svc:2222/repos/repo-tools.git \
  && git config core.sshCommand "ssh -i /keys/client -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
