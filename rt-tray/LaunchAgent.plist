<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rt.daemon</string>

    <key>BundleProgram</key>
    <string>Contents/MacOS/rt-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>Contents/MacOS/rt-daemon</string>
        <string>--daemon</string>
    </array>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.rt.tray</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- ProcessType=Interactive defaults ExitTimeOut to 5s, which is too tight
         for cleanup() (close API/WS server, drain 8+ websockets, tear down
         tunnels/children, flush 900KB cache). Without this override launchd
         escalates SIGTERM → SIGKILL and the "daemon stopped" line never lands. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <!-- NOTE: StandardOutPath/StandardErrorPath intentionally omitted.
         macOS 26 broke $(HOME) expansion in SMAppService-registered plists,
         causing EX_CONFIG / spawn failed. The daemon self-redirects fd 2 to
         ~/.rt/logs/daemon-stderr.log at startup (redirectNativeStderr in
         lib/daemon-logger.ts); JSON logs go to ~/.rt/logs/daemon.<date>.log
         via pino. -->

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
