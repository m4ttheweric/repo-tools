<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Label: com.mattstack.daemon (prod) / com.mattstack.daemon.dev (dev). -->
    <key>Label</key>
    <string>@@DAEMON_LABEL@@</string>

    <key>BundleProgram</key>
    <string>Contents/MacOS/rt</string>

    <key>ProgramArguments</key>
    <array>
        <string>Contents/MacOS/rt</string>
        <string>--daemon</string>
    </array>

    <!-- Must match the bundle's own CFBundleIdentifier exactly -- FDA
         inheritance to the daemon breaks silently otherwise. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>@@BUNDLE_ID@@</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive is injected by `scripts/render-launchagents.sh` as
         {SuccessfulExit:false} for both flavors. -->

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- ProcessType=Interactive defaults ExitTimeOut to 5s, which is too tight
         for cleanup() (close API/WS server, drain 8+ websockets, tear down
         tunnels/children, flush 900KB cache). Without this override launchd
         escalates SIGTERM → SIGKILL and the "daemon stopped" line never lands. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <!-- NOTE: StandardOutPath/StandardErrorPath intentionally omitted.
         macOS 26 broke $(HOME) expansion in SMAppService-registered plists,
         causing EX_CONFIG / spawn failed. The daemon self-redirects fd 2 to
         ~/.rt/logs/daemon-stderr.log at startup (redirectNativeStderr in
         lib/daemon-logger.ts); JSON logs go to ~/.rt/logs/daemon.<date>.log
         via pino. -->

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
