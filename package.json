    "react-devtools-core": "^7.0.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@rezi-ui/core": "^0.1.0-alpha.60",
    "@rezi-ui/jsx": "^0.1.0-alpha.60",
    "@rezi-ui/node": "^0.1.0-alpha.60",
    "@workforge/glance-sdk": "0.8.1",
    "cli-highlight": "^2.1.11",
    "fullscreen-ink": "^0.1.0",
    "ink": "^6.8.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
